# Track project sources, documentation, and pinned Git submodules.
/*
!/.gitignore
!/.gitmodules
!/README.md
!/src/
!/third_party/
/third_party/*
!/third_party/plugin-sdk/
/third_party/plugin-sdk/*
!/third_party/plugin-sdk/plugin-sdk/
!/third_party/III.VC.SA.WindowedMode/
!/third_party/ScriptHookVDotNetEnhanced/
!/third_party/ReShade/
!/reference/
/reference/*
!/reference/gta-reversed/
!/reference/universal-modder
!/reference/Gta-V-Enhanced-Minecraft-Steve-Passthrough
!/reference/minecraft-in-gta-enhanced
!/reference/SkyCraft

# Local build output from the tracked PortalSA project.
/src/PortalSA/bin/
/src/PortalSA/obj/
/src/PortalSA/.vs/
/src/PortalSA/*.vcxproj.user

# Local build output from the PortalDev utility.
/src/PortalDev/bin/
/src/PortalDev/obj/
/src/PortalDev/.vs/
/src/PortalDev/*.vcxproj.user

# Local GTA V plugin build output.
/src/PortalV/bin/
/src/PortalV/obj/
/src/PortalV/.vs/
/src/PortalV/*.vcxproj.user

/src/tests/bin/
/src/tests/obj/
